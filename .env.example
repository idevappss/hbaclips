# ═══════════════════════════════════════════════════════════════
#  INTEGRATIONS / API KEYS — template (no secrets here)
#  Copy to .env and fill in. .env is gitignored.
#  Restart the app (npm start) after changing anything.
# ═══════════════════════════════════════════════════════════════

# ── Claude (Anthropic) ─────────────────────────────────────────
# Clip analysis (lib/analyze.js) and titles (titles/)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── Instagram (Meta) ───────────────────────────────────────────
# Optional: only needed for the "Log in with Instagram" button.
# Tokens pasted on the Connect page work without these.
# Meta app (type Business) → Instagram → API setup with Instagram login
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT_URI=
# IG_API_VERSION=v25.0

# ── YouTube (Google) ───────────────────────────────────────────
# Analytics tab: public channel + video stats (analytics/).
# Google Cloud → enable "YouTube Data API v3" → Credentials → API key
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# ── Voice / music / media (optional) ───────────────────────────
# ELEVENLABS_API_KEY=
# HEYGEN_API_KEY=
# GEMINI_API_KEY=

# ── App settings ───────────────────────────────────────────────
PORT=5173
# WHISPER_MODEL=small.en   # tiny.en | base.en | small.en | medium.en | large-v3
